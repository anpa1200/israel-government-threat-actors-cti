        ]
      },
      {
        "case_id": "DET-002-NEG-004",
        "expected": false,
        "events": [
          {
            "FileName": "certutil.exe",
            "ProcessCommandLine": "certutil.exe -urlcache -split -f https://vendor.example/approved-rmm/atera.exe C:\\Users\\admin\\Downloads\\atera.exe",
