        "expected": true,
        "events": [
          {
            "FileName": "powershell.exe",
            "ProcessCommandLine": "powershell.exe -ExecutionPolicy Bypass -File C:\\Users\\analyst\\Downloads\\install-anydesk.ps1",
            "InitiatingProcessFileName": "chrome.exe",
            "ApprovedRmm": false
          }
        ]
      },
      {
        "case_id": "DET-002-POS-002",
        "expected": true,
        "events": [
          {
            "FileName": "cmd.exe",
            "ProcessCommandLine": "cmd.exe /c C:\\Users\\analyst\\AppData\\Local\\Temp\\tacticalrmm-installer.exe",
            "InitiatingProcessFileName": "outlook.exe",
            "ApprovedRmm": false
          }
        ]
      },
      {
        "case_id": "DET-002-NEG-001",
        "expected": false,
        "events": [
          {
            "FileName": "msiexec.exe",
