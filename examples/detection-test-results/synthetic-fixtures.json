      {
        "case_id": "DET-002-NEG-002",
        "expected": false,
        "events": [
          {
            "FileName": "powershell.exe",
            "ProcessCommandLine": "powershell.exe -File C:\\Users\\analyst\\Downloads\\inventory.ps1",
            "InitiatingProcessFileName": "explorer.exe",
